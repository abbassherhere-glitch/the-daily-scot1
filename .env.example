# ---------------------------------------------------------------------------
# The Daily Scot – configuration reference. Copy values into Cloudflare, never commit real secrets.
# ---------------------------------------------------------------------------

# ===== Public site build (Pages project "daily-scot-public" > Settings > Variables, BUILD-time) =====
# Cloudflare Turnstile SITE key (public). Enables the spam check on the newsletter form.
VITE_TURNSTILE_SITE_KEY=""

# ===== Public site runtime secrets (wrangler pages secret put <NAME> --project-name daily-scot-public) =====
# Turnstile SECRET key – must be set together with VITE_TURNSTILE_SITE_KEY
TURNSTILE_SECRET=""
# Resend API key for newsletter confirmation emails (sending domain must be verified in Resend)
RESEND_API_KEY=""
# Optional overrides
SITE_URL="https://thedailyscot.co.uk"
NEWSLETTER_FROM="The Daily Scot <newsletter@thedailyscot.co.uk>"

# ===== Newsroom CMS (admin-app/wrangler.toml [vars]) – REQUIRED, admin login is disabled until set =====
# Zero Trust > Settings > Custom Pages: your team domain is <team>.cloudflareaccess.com – enter only <team>
CF_ACCESS_TEAM_DOMAIN=""
# Zero Trust > Access > Applications > (Newsroom app) > Overview > Application Audience (AUD) Tag
CF_ACCESS_AUD=""
# Public URL of the R2 media bucket (custom domain or r2.dev URL)
MEDIA_PUBLIC_URL="https://media.thedailyscot.co.uk"

# ===== Newsroom CMS secrets (wrangler pages secret put <NAME> --project-name daily-scot-admin) =====
# Client ID of the Cloudflare Access service token used by the wire-ingest bot
BOT_CLIENT_ID=""
# Optional fallback if the bot calls the API without going through Access
CF_ACCESS_SERVICE_CLIENT_ID=""
CF_ACCESS_SERVICE_CLIENT_SECRET=""

# ===== Local development only (.dev.vars) =====
# ENVIRONMENT="local" enables the X-Dev-User-Email header on localhost. NEVER set this in production.
# ENVIRONMENT="local"
