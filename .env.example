# Cloudflare Zero Trust (Access) configuration for /admin protection
# Find your Team Domain in Cloudflare Zero Trust > Settings > Custom Pages / General
CF_ACCESS_TEAM_DOMAIN="daily-scot-team"

# The Application Audience (AUD) tag for your Access Application protecting /admin
# Found in Zero Trust > Access > Applications > (Your App) > Overview
CF_ACCESS_AUD="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Public URL or Custom Domain for your Cloudflare R2 bucket "MEDIA"
# e.g., https://media.dailyscot.co.uk or Cloudflare R2 dev URL
MEDIA_PUBLIC_URL="https://media.dailyscot.co.uk"
