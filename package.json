{
  "name": "the-daily-scot",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "build:admin": "vite build --config admin-app/vite.config.ts",
    "dev:admin": "vite --config admin-app/vite.config.ts --port=3001",
    "preview": "vite preview",
    "clean": "rm -rf dist admin-app/dist",
    "lint": "tsc --noEmit",
    "db:migrate": "wrangler d1 execute daily-scot-db --remote --file=./migrations/0001_init.sql && wrangler d1 execute daily-scot-db --remote --file=./migrations/0002_production_setup.sql && wrangler d1 execute daily-scot-db --remote --file=./migrations/0003_bylines.sql"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dompurify": "^3.4.17",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
